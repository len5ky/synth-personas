# =============================================================================
# synth-personas — copy to .env and fill in your key.
# The CLI auto-loads .env from the current working directory at startup.
# =============================================================================

# OpenRouter API key. Sign up at https://openrouter.ai/.
# Used to fan out one LLM call per persona.
OPENROUTER_API_KEY=


# Optional: point at your own persona library (overrides the bundled one).
# Must be a directory of the form <root>/<category>/<slug>.md.
# SYNTH_PERSONA_PERSONAS_ROOT=./my-personas


# Optional: HTTP referer header sent to OpenRouter (shows up on your dashboard).
# OPENROUTER_HTTP_REFERER=https://github.com/len5ky/synth-personas
